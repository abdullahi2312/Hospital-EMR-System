PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/hospital_emr
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=1d
PAYMENT_FINGERPRINT_SECRET=REPLACE_WITH_A_DISTINCT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
PATIENT_IDENTITY_HMAC_SECRET=REPLACE_WITH_A_DISTINCT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Optional broad input plausibility bounds; these reject impossible/out-of-domain data, not abnormal readings.
VITAL_MIN_TEMPERATURE_C=20
VITAL_MAX_TEMPERATURE_C=45
VITAL_MIN_PULSE_BPM=1
VITAL_MAX_PULSE_BPM=300
VITAL_MIN_SYSTOLIC_MMHG=40
VITAL_MAX_SYSTOLIC_MMHG=300
VITAL_MIN_DIASTOLIC_MMHG=20
VITAL_MAX_DIASTOLIC_MMHG=200
VITAL_MIN_WEIGHT_KG=0.1
VITAL_MAX_WEIGHT_KG=500
VITAL_MIN_HEIGHT_CM=20
VITAL_MAX_HEIGHT_CM=300
# Optional plausibility bounds for newly recorded respiratory rate and SpO2.
VITAL_MIN_RESPIRATORY_RATE_PER_MIN=1
VITAL_MAX_RESPIRATORY_RATE_PER_MIN=100
VITAL_MIN_SPO2_PERCENT=1
# Configurable adult reference thresholds used only to flag readings, not diagnose.
# Defaults are generic reference values and are not adjusted for age, pregnancy, or condition.
VITAL_FLAG_SYSTOLIC_LOW_MMHG=90
VITAL_FLAG_SYSTOLIC_HIGH_MMHG=180
VITAL_FLAG_DIASTOLIC_LOW_MMHG=60
VITAL_FLAG_DIASTOLIC_HIGH_MMHG=120
VITAL_FLAG_TEMPERATURE_LOW_C=36
VITAL_FLAG_TEMPERATURE_HIGH_C=38
VITAL_FLAG_HEART_RATE_LOW_BPM=50
VITAL_FLAG_HEART_RATE_HIGH_BPM=120
VITAL_FLAG_RESPIRATORY_RATE_LOW_PER_MIN=12
VITAL_FLAG_RESPIRATORY_RATE_HIGH_PER_MIN=20
VITAL_FLAG_SPO2_LOW_PERCENT=92
