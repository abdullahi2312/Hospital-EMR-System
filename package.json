{
    "name":  "hospital-emr-backend",
    "version":  "1.0.0",
    "private":  true,
    "description":  "Backend API for the Somali 10X Challenge Hospital EMR System",
    "main":  "server/server.js",
    "scripts":  {
                    "start":  "node server/server.js",
                    "dev":  "nodemon server/server.js",
                    "test":  "node --test server/tests/*.test.js",
                    "test:integration":  "node --test server/tests/mongodb.integration.test.js",
                    "db:indexes":  "node server/scripts/ensure-indexes.js",
                    "admin:bootstrap":  "node server/scripts/bootstrap-admin.js",
                    "config:patient-secret":  "node server/scripts/ensure-local-patient-secret.js"
                },
    "dependencies":  {
                         "@fontsource/noto-sans":  "^5.3.0",
                         "@pdf-lib/fontkit":  "^1.1.1",
                         "bcrypt":  "^6.0.0",
                         "dotenv":  "^16.4.7",
                         "express":  "^5.1.0",
                         "jsonwebtoken":  "^9.0.3",
                         "mongoose":  "8.24.8",
                         "pdf-lib":  "^1.17.1"
                     },
    "devDependencies":  {
                            "nodemon":  "^3.1.10"
                        }
}
